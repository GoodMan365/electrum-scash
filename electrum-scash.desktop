# If you want Electrum to appear in a Linux app launcher ("start menu"), install this by doing:
# sudo desktop-file-install electrum-scash.desktop
# Note: This assumes $HOME/.local/bin is in your $PATH

[Desktop Entry]
Comment=Lightweight Scash Client
Exec=run_electrum-scash %u
GenericName=Scash Wallet
GenericName[en_US]=Scash Wallet
Icon=electrum-scash
Name=Electrum Scash Wallet
Name[en_US]=Electrum Scash Wallet
Categories=Finance;Network;
StartupNotify=true
StartupWMClass=electrum
Terminal=false
Type=Application
#MimeType=x-scheme-handler/bitcoin;
Actions=Testnet;
Keywords=crypto;currency;SCASH;scash;wallet

[Desktop Action Testnet]
Exec=electrum-scash --testnet %u
Name=Testnet mode
